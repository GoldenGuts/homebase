<?xml version="1.0" encoding="utf-8"?>
<!-- Widget settings and defaults are backed up and transferred; tokens (hawidgets.xml) and caches are not. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="widgets.xml" />
        <include domain="sharedpref" path="config.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="widgets.xml" />
        <include domain="sharedpref" path="config.xml" />
    </device-transfer>
</data-extraction-rules>
